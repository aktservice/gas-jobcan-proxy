{
  "name": "jobcan-rest",
  "version": "1.0.0",
  "type": "module",
  "description": "Jobcan REST API proxy for Google Apps Script",
  "author": "yoshikoro",
  "license": "ISC",
  "scripts": {
    "build": "node ./esbuild.js",
    "typecheck": "tsc",
    "test": "node --loader ts-node/esm test/*.test.ts",
    "check": "npm run typecheck && npm test",
    "push": "clasp push",
    "deploy": "npm run check && npm run build && npm run push",
    "open": "clasp open"
  },
  "devDependencies": {
    "@types/google-apps-script": "^2.0.8",
    "@types/node": "^25.2.0",
    "esbuild": "^0.27.2",
    "esbuild-gas-plugin": "^0.10.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.3"
  }
}
